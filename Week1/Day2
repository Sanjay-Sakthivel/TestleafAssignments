function isOddorEven (a)
{
    if (a%2==0)
    {
        //console.log(a);
        console.log(a + " is Even");
    }
    else
    {    //console.log(a);
        console.log(a + " is Odd");
}
}

for (a=1; a<=10; a++)
{
    isOddorEven(a);
}

